<%- include('partials/header') %>

<div class="success-card">
  <div class="success-icon">✓</div>
  <h1>תודה על ההזמנה!</h1>
  <p>הזמנה <strong>#<%= order.id %></strong> התקבלה בהצלחה.</p>
  <p>סטטוס: <span class="status status-<%= order.status %>"><%= order.status %></span></p>
  <p>סך הכל: <strong><%= formatCurrency(order.total) %></strong></p>
</div>

<div class="card receipt-card">
  <h2 class="receipt-title">🎟 קודי המימוש שלך</h2>
  <p class="muted">היכנסו לשרת FiveM וכתבו בצ'אט: <code class="cmd-example">/redeem &lt;קוד&gt;</code></p>

  <div class="receipt-list">
    <% order.items.forEach(function(it){ %>
      <div class="receipt-row">
        <div class="receipt-info">
          <div class="receipt-product"><%= it.product_name %> × <%= it.qty %></div>
          <% if (it.redeemed) { %>
            <span class="status status-paid">מומש ✓</span>
          <% } else { %>
            <span class="status status-pending">ממתין למימוש</span>
          <% } %>
        </div>
        <div class="receipt-code-wrap">
          <code class="receipt-code" id="rc-<%= it.id %>"><%= it.receipt_code || '—' %></code>
          <button type="button" class="btn btn-ghost btn-sm" onclick="copyRC('rc-<%= it.id %>')">העתק</button>
        </div>
      </div>
    <% }); %>
  </div>

  <p class="muted small">שלחנו עותק של הקודים גם למייל שלך.</p>
</div>

<div class="success-actions">
  <a href="/dashboard" class="btn btn-primary">לאזור האישי</a>
  <a href="/" class="btn btn-ghost">חזרה לחנות</a>
</div>

<script>
function copyRC(id){
  const el = document.getElementById(id);
  navigator.clipboard.writeText(el.textContent.trim()).then(() => {
    el.classList.add('flash-copy');
    setTimeout(() => el.classList.remove('flash-copy'), 800);
  });
}
</script>

<%- include('partials/footer') %>
