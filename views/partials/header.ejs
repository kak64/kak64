<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Infinity IL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
</head>
<body>
  <div class="bg-stars" aria-hidden="true"></div>
  <div class="bg-glow" aria-hidden="true"></div>

  <% if (announcement) { %>
    <div class="announcement-bar">
      <div class="container ann-inner">
        <% if (announcementLink) { %>
          <a href="<%= announcementLink %>"><%= announcement %></a>
        <% } else { %>
          <span><%= announcement %></span>
        <% } %>
      </div>
    </div>
  <% } %>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <img src="/img/logo.svg" alt="Infinity IL" class="brand-logo">
        <div class="brand-text">
          <span class="brand-name">INFINITY <span class="brand-il">IL</span></span>
          <span class="brand-sub">ROLEPLAY</span>
        </div>
      </a>

      <form action="/search" method="get" class="search-box">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" name="q" placeholder="חפשו רכב, נשק, חבילה..." value="<%= typeof q !== 'undefined' ? q : '' %>">
      </form>

      <div class="header-actions">
        <% if (user) { %>
          <a href="/wishlist" class="cart-btn" title="מועדפים">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7.5-4.5-9.5-9.5C1.5 8 4 5 7 5c2 0 3.5 1 5 3 1.5-2 3-3 5-3 3 0 5.5 3 4.5 6.5C19.5 16.5 12 21 12 21z"/></svg>
          </a>
        <% } %>
        <a href="/cart" class="cart-btn" title="עגלה">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-13z"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M6 6L4 2H1"/></svg>
          <% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
        </a>
        <% if (user) { %>
          <div class="user-menu">
            <a href="/dashboard" class="user-chip">
              <% if (user.avatar_url) { %><img src="<%= user.avatar_url %>" alt=""><% } else { %><span class="user-initial"><%= (user.username || '?').slice(0,1).toUpperCase() %></span><% } %>
              <span><%= user.username %></span>
              <% if (user.points > 0) { %><span class="points-pill">✦ <%= user.points %></span><% } %>
              <% if (user.is_admin) { %><span class="admin-pill">ADMIN</span><% } %>
            </a>
            <% if (user.is_admin) { %>
              <a href="/admin" class="btn btn-ghost btn-sm">ניהול</a>
            <% } %>
            <form method="post" action="/auth/logout" class="inline">
              <button class="btn btn-ghost btn-sm" type="submit">התנתק</button>
            </form>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-ghost btn-sm">התחברות</a>
          <a href="/auth/register" class="btn btn-primary btn-sm">הרשמה</a>
        <% } %>
      </div>
    </div>
  </header>

  <% if (flash) { %>
    <div class="container">
      <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
    </div>
  <% } %>

  <main class="site-main container">
