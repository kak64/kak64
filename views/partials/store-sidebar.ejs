<aside class="store-sidebar">

  <!-- Server status panel -->
  <div class="store-panel">
    <div class="sp-head">
      <span class="sp-icon">🎮</span>
      <span>סטטוס השרת</span>
    </div>
    <div id="server-status" class="server-status loading sp-server" data-name="<%= fivemServerName || 'Infinity IL Roleplay' %>">
      <div class="ss-dot"></div>
      <div class="ss-text">
        <div class="ss-name"><%= fivemServerName || 'Infinity IL Roleplay' %></div>
        <div class="ss-state muted">בודק חיבור…</div>
      </div>
      <div class="ss-players">
        <span class="ss-num">—</span><span class="ss-max"></span>
      </div>
    </div>
    <% if (discordInvite) { %>
      <a href="<%= discordInvite %>" target="_blank" rel="noopener" class="btn btn-discord block btn-sm" style="margin-top:10px">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.196.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        הצטרפו לדיסקורד
      </a>
    <% } %>
  </div>

  <!-- Monthly goal panel -->
  <% if (typeof monthlyGoal !== 'undefined' && monthlyGoal > 0) {
       var pct = Math.min(100, Math.round((monthlySales / monthlyGoal) * 100));
  %>
    <div class="store-panel goal-panel">
      <div class="sp-head">
        <span class="sp-icon">🎯</span>
        <span><%= monthlyGoalLabel %></span>
      </div>
      <div class="goal-amounts">
        <strong><%= formatCurrency(monthlySales) %></strong>
        <span class="muted">/ <%= formatCurrency(monthlyGoal) %></span>
      </div>
      <div class="goal-bar"><div class="goal-fill" style="width: <%= pct %>%"></div></div>
      <div class="muted small center"><%= pct %>% הושג</div>
    </div>
  <% } %>

  <!-- Top buyers leaderboard -->
  <% if (typeof topBuyers !== 'undefined' && topBuyers.length) { %>
    <div class="store-panel">
      <div class="sp-head">
        <span class="sp-icon">👑</span>
        <span>מובילי החודש</span>
      </div>
      <ol class="lb-list">
        <% topBuyers.forEach(function(b, i){ %>
          <li class="lb-row lb-<%= i + 1 %>">
            <span class="lb-rank"><%= i + 1 %></span>
            <% if (b.avatar_url) { %><img src="<%= b.avatar_url %>" alt="" class="lb-avatar"><% } else { %><span class="lb-avatar fallback"><%= (b.username || '?').slice(0,1).toUpperCase() %></span><% } %>
            <span class="lb-name"><%= b.username %></span>
            <span class="lb-amount"><%= formatCurrency(b.total_spent) %></span>
          </li>
        <% }); %>
      </ol>
    </div>
  <% } %>

  <!-- Recent purchases panel -->
  <% if (typeof activity !== 'undefined' && activity.length) { %>
    <div class="store-panel">
      <div class="sp-head">
        <span class="sp-icon"><span class="live-dot inline-dot"></span></span>
        <span>רכישות אחרונות</span>
      </div>
      <ul class="recent-list">
        <% activity.slice(0, 6).forEach(function(a){ %>
          <li class="recent-row">
            <% if (a.avatar_url) { %><img src="<%= a.avatar_url %>" alt="" class="ticker-avatar"><% } else { %><span class="ticker-avatar fallback"><%= (a.username || '?').slice(0,1).toUpperCase() %></span><% } %>
            <div class="recent-text">
              <strong><%= a.username || 'אורח' %></strong>
              <span class="muted small">רכש/ה</span>
              <a href="/product/<%= a.product_id %>"><%= a.product_name %></a>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

</aside>
