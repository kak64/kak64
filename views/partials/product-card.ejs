<%
  var flash = getActiveFlashForProduct(product.id);
  var unit = effectivePrice(product, flash);
  var rating = avgRating(product);
  var ratingCount = product.rating_count || 0;
  var sold = product.sold_count || 0;
  var stockLow = (product.stock !== null && product.stock !== undefined && product.stock > 0 && product.stock <= 5);
  var soldOut = (product.stock === 0);
  var isFav = typeof user !== 'undefined' && user ? isWishlisted(product.id) : false;
%>
<article class="product-card <%= soldOut ? 'is-sold-out' : '' %>" style="--cat-color: <%= product.category_color || '#a855f7' %>">
  <% if (flash) { %>
    <span class="badge flash-badge" data-ends="<%= flash.ends_at %>">⚡ FLASH</span>
  <% } else if (product.badge) { %>
    <span class="badge" style="background: <%= product.badge_color || '#a855f7' %>"><%= product.badge %></span>
  <% } %>

  <% if (typeof user !== 'undefined' && user) { %>
    <form method="post" action="/wishlist/toggle" class="wish-form">
      <input type="hidden" name="product_id" value="<%= product.id %>">
      <button type="submit" class="wish-btn <%= isFav ? 'is-fav' : '' %>" title="מועדפים">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 21s-7.5-4.5-9.5-9.5C1.5 8 4 5 7 5c2 0 3.5 1 5 3 1.5-2 3-3 5-3 3 0 5.5 3 4.5 6.5C19.5 16.5 12 21 12 21z"/></svg>
      </button>
    </form>
  <% } %>

  <a href="/product/<%= product.id %>" class="product-image">
    <% if (product.image_url) { %>
      <img src="<%= product.image_url %>" alt="<%= product.name %>" loading="lazy">
    <% } else { %>
      <div class="image-placeholder">
        <span class="ph-icon"><%= product.category_icon || '✦' %></span>
        <span class="ph-text"><%= product.category_name || 'INFINITY' %></span>
      </div>
    <% } %>
    <% if (soldOut) { %>
      <div class="sold-overlay">אזל מהמלאי</div>
    <% } else if (stockLow) { %>
      <div class="stock-pill">🔥 נשארו <%= product.stock %> בלבד</div>
    <% } %>
  </a>
  <div class="product-body">
    <a href="/product/<%= product.id %>" class="product-title"><%= product.name %></a>

    <% if (ratingCount > 0 || sold > 0) { %>
      <div class="card-meta">
        <% if (ratingCount > 0) { %>
          <span class="stars-mini" title="<%= rating.toFixed(1) %> מתוך 5">
            <% for (var i = 1; i <= 5; i++) { %><span class="<%= i <= Math.round(rating) ? 'on' : '' %>">★</span><% } %>
            <span class="muted small"><%= ratingCount %></span>
          </span>
        <% } %>
        <% if (sold > 0) { %><span class="muted small">· <%= sold %> נמכרו</span><% } %>
      </div>
    <% } %>

    <p class="product-desc"><%= product.description %></p>

    <% if (flash) { %>
      <div class="flash-countdown" data-ends="<%= flash.ends_at %>">⏱ <span class="cd-text">—</span></div>
    <% } %>

    <div class="product-foot">
      <% if (soldOut) { %>
        <span class="btn btn-ghost btn-sm" style="opacity:.6;cursor:not-allowed">אזל</span>
      <% } else { %>
        <form method="post" action="/cart/add" class="inline">
          <input type="hidden" name="product_id" value="<%= product.id %>">
          <button type="submit" class="btn btn-primary btn-sm">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            הוסף לסל
          </button>
        </form>
      <% } %>
      <div class="price">
        <% if (flash) { %>
          <span class="price-old"><%= formatCurrency(product.price) %></span>
          <span class="price-now flash"><%= formatCurrency(unit) %></span>
        <% } else if (product.sale_price && product.sale_price > 0) { %>
          <span class="price-old"><%= formatCurrency(product.price) %></span>
          <span class="price-now"><%= formatCurrency(product.sale_price) %></span>
        <% } else { %>
          <span class="price-now"><%= formatCurrency(product.price) %></span>
        <% } %>
      </div>
    </div>
  </div>
</article>
