<div class="rack-stage">
  <svg viewBox="0 0 360 420" xmlns="http://www.w3.org/2000/svg" class="rack-svg" fill="none">
    <defs>
      <linearGradient id="rackG" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1e293b"/>
        <stop offset="1" stop-color="#0f172a"/>
      </linearGradient>
      <linearGradient id="srvG" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1e3a5f"/>
        <stop offset="1" stop-color="#0c1f3d"/>
      </linearGradient>
      <linearGradient id="cyanG" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#0284c7"/>
        <stop offset="1" stop-color="#22d3ee"/>
      </linearGradient>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="2"/>
      </filter>
    </defs>

    <!-- Rack body -->
    <rect x="60" y="20" width="240" height="380" rx="12" fill="url(#rackG)" stroke="#1e293b" stroke-width="2"/>
    <rect x="68" y="28" width="224" height="364" rx="6" fill="#0a1228"/>

    <!-- Servers (5 units) -->
    <% for (let i = 0; i < 5; i++) { %>
      <g class="rack-srv" style="--i: <%= i %>">
        <rect x="76" y="<%= 40 + i * 70 %>" width="208" height="56" rx="4" fill="url(#srvG)" stroke="#243757" stroke-width="1"/>
        <!-- Slots -->
        <rect x="86" y="<%= 50 + i * 70 %>" width="40" height="36" rx="2" fill="#0f1a36"/>
        <rect x="130" y="<%= 50 + i * 70 %>" width="40" height="36" rx="2" fill="#0f1a36"/>
        <rect x="174" y="<%= 50 + i * 70 %>" width="40" height="36" rx="2" fill="#0f1a36"/>
        <rect x="218" y="<%= 50 + i * 70 %>" width="40" height="36" rx="2" fill="#0f1a36"/>
        <!-- LEDs -->
        <circle cx="270" cy="<%= 56 + i * 70 %>" r="3" fill="#22d3ee" class="led-blink"/>
        <circle cx="270" cy="<%= 70 + i * 70 %>" r="3" fill="#10b981" class="led-blink" style="animation-delay: <%= 0.3 + i * 0.2 %>s"/>
        <circle cx="270" cy="<%= 84 + i * 70 %>" r="3" fill="#06b6d4" class="led-blink" style="animation-delay: <%= 0.6 + i * 0.15 %>s"/>
      </g>
    <% } %>

    <!-- Data flow line at top -->
    <path d="M 60 20 L 180 -10 L 300 20" stroke="url(#cyanG)" stroke-width="2" stroke-dasharray="4 6" class="data-flow" fill="none"/>

    <!-- Floating particles -->
    <circle cx="20" cy="60" r="3" fill="#22d3ee" class="float-1" filter="url(#glow)"/>
    <circle cx="340" cy="120" r="4" fill="#06b6d4" class="float-2" filter="url(#glow)"/>
    <circle cx="30" cy="280" r="3" fill="#0284c7" class="float-3" filter="url(#glow)"/>
    <circle cx="335" cy="340" r="3" fill="#22d3ee" class="float-1" style="animation-delay: 1.5s" filter="url(#glow)"/>
  </svg>

  <!-- Connection lines drawn over -->
  <div class="rack-glow"></div>
</div>
