<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | KAK64 Hosting</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% if (impersonating) { %>
    <div class="impersonation-banner">
      <span>אתה מתחזה כעת ל-<strong><%= user.full_name %></strong></span>
      <form method="post" action="/stop-impersonating" class="inline-form">
        <button type="submit" class="btn btn-sm">חזרה לחשבון מנהל</button>
      </form>
    </div>
  <% } %>
  <%- include('partials/header') %>
  <main class="container">
    <% if (flash.success && flash.success.length) { %>
      <div class="alert alert-success"><%= flash.success.join(' ') %></div>
    <% } %>
    <% if (flash.error && flash.error.length) { %>
      <div class="alert alert-error"><%= flash.error.join(' ') %></div>
    <% } %>
    <% if (flash.info && flash.info.length) { %>
      <div class="alert alert-info"><%= flash.info.join(' ') %></div>
    <% } %>
    <%- body %>
  </main>
  <%- include('partials/footer') %>
  <% if (user) { %>
    <%- include('partials/help-widget') %>
  <% } %>
</body>
</html>
