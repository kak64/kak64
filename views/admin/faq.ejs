<%- include('../partials/header') %>
<div class="dash-layout">
  <%- include('_sidebar') %>
  <main class="dash-main">
    <h1 class="page-title">שאלות נפוצות</h1>

    <div class="card">
      <h3>שאלה חדשה</h3>
      <form method="post" action="/admin/faq/new">
        <label>שאלה</label>
        <input type="text" name="question" required>
        <label>תשובה</label>
        <textarea name="answer" rows="3" required></textarea>
        <label>סדר תצוגה</label>
        <input type="number" name="sort_order" value="0">
        <label class="checkbox"><input type="checkbox" name="active" value="1" checked> פעיל</label>
        <button class="btn btn-primary mt">הוסף</button>
      </form>
    </div>

    <% items.forEach(function(f){ %>
      <div class="card">
        <h3><%= f.question %></h3>
        <p class="muted"><%= f.answer %></p>
        <form method="post" action="/admin/faq/<%= f.id %>/delete" onsubmit="return confirm('למחוק?')">
          <button class="btn btn-danger btn-sm">מחק</button>
        </form>
      </div>
    <% }); %>
  </main>
</div>
<%- include('../partials/footer') %>
