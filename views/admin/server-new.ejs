<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar') %>
  <section class="dashboard-main">
    <h1>פתיחת שרת חדש ללקוח</h1>

    <form method="post" action="/admin/servers/new" class="card">
      <h3>1. בחירת לקוח</h3>
      <label>
        <span>לקוח <span class="req">*</span></span>
        <select name="user_id" required>
          <option value="">-- בחר לקוח --</option>
          <% users.forEach(function(u) { %>
            <option value="<%= u.id %>" <%= String(selectedUserId) === String(u.id) ? 'selected' : '' %>>
              <%= u.full_name %> (<%= u.email %>)
            </option>
          <% }) %>
        </select>
      </label>

      <h3>2. בחירת חבילה</h3>
      <div class="plan-radio-grid">
        <% plans.forEach(function(p) { %>
          <label class="plan-radio">
            <input type="radio" name="plan_id" value="<%= p.id %>" required>
            <div class="plan-radio-content">
              <strong><%= p.name %></strong>
              <div class="price"><%= p.price_monthly %> ₪/חודש</div>
              <div class="muted"><%= p.cpu %> CPU · <%= p.ram_gb %>GB · <%= p.disk_gb %>GB</div>
            </div>
          </label>
        <% }) %>
      </div>

      <h3>3. הגדרות שרת</h3>
      <div class="form-row">
        <label>
          <span>שם שרת (hostname) <span class="req">*</span></span>
          <input type="text" name="hostname" pattern="[a-zA-Z0-9.\-]{2,63}" required dir="ltr" placeholder="server-01">
        </label>
        <label>
          <span>מערכת הפעלה <span class="req">*</span></span>
          <select name="os" required>
            <option value="Ubuntu 22.04">Ubuntu 22.04 LTS</option>
            <option value="Debian 12">Debian 12</option>
            <option value="CentOS Stream 9">CentOS Stream 9</option>
            <option value="Rocky Linux 9">Rocky Linux 9</option>
            <option value="Windows Server 2022">Windows Server 2022</option>
          </select>
        </label>
      </div>
      <label>
        <span>סיסמת root (השאר ריק כדי לייצר אקראית)</span>
        <input type="text" name="root_password" minlength="8" dir="ltr" placeholder="(אקראי)">
      </label>

      <h3>4. תקופה וחיוב</h3>
      <div class="form-row">
        <label>
          <span>תקופה (חודשים)</span>
          <select name="months">
            <option value="1">חודש</option>
            <option value="3">3 חודשים</option>
            <option value="6">6 חודשים</option>
            <option value="12">שנה</option>
          </select>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="bill_now" checked> צור חשבונית ללקוח
        </label>
      </div>
      <p class="muted">בלי "צור חשבונית" — השרת ייפתח חינם ללא חיוב (לדוגמה: ניסיון, פיצוי, מתנה).</p>

      <button type="submit" class="btn btn-primary btn-block btn-lg">פתח שרת</button>
    </form>
  </section>
</div>
