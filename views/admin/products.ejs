<%- include('../partials/header') %>
<div class="dash-layout">
  <%- include('_sidebar') %>
  <main class="dash-main">
    <div class="head-row">
      <h1 class="page-title">מוצרים</h1>
      <a href="/admin/products/new" class="btn btn-primary">+ מוצר חדש</a>
    </div>
    <table class="data-table">
      <thead><tr><th>#</th><th>תמונה</th><th>שם</th><th>קטגוריה</th><th>מחיר</th><th>פעיל</th><th></th></tr></thead>
      <tbody>
        <% products.forEach(function(p){ %>
          <tr>
            <td><%= p.id %></td>
            <td>
              <% if (p.image_url) { %>
                <img src="<%= p.image_url %>" alt="" style="width:48px;height:48px;border-radius:8px;object-fit:cover">
              <% } else { %>
                <div class="image-placeholder small" style="width:48px;height:48px">✦</div>
              <% } %>
            </td>
            <td>
              <%= p.name %>
              <% if (p.badge) { %><span class="badge inline" style="background: <%= p.badge_color || '#a855f7' %>"><%= p.badge %></span><% } %>
              <% if (p.is_package) { %><span class="tag">חבילה</span><% } %>
            </td>
            <td><%= p.category_name || '—' %></td>
            <td><%= formatCurrency(p.sale_price || p.price) %></td>
            <td><%= p.active ? '✓' : '✗' %></td>
            <td>
              <a class="btn btn-ghost btn-sm" href="/admin/products/<%= p.id %>/edit">ערוך</a>
              <form method="post" action="/admin/products/<%= p.id %>/delete" class="inline" onsubmit="return confirm('למחוק?')">
                <button class="btn btn-danger btn-sm" type="submit">מחק</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</div>
<%- include('../partials/footer') %>
