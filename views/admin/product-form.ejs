<%- include('../partials/header') %>
<div class="dash-layout">
  <%- include('_sidebar') %>
  <main class="dash-main">
    <a href="/admin/products" class="muted">← חזרה למוצרים</a>
    <h1 class="page-title"><%= product ? 'עריכת מוצר' : 'מוצר חדש' %></h1>

    <form method="post" action="<%= product ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" enctype="multipart/form-data" class="card form-grid">
      <div class="form-col">
        <label>שם המוצר *</label>
        <input type="text" name="name" required value="<%= product ? product.name : '' %>">

        <label>קטגוריה</label>
        <select name="category_id">
          <option value="">— ללא —</option>
          <% categories.forEach(function(c){ %>
            <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.icon %> <%= c.name %></option>
          <% }); %>
        </select>

        <label>תיאור</label>
        <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>

        <label>תכולה / כלול בחבילה (שורה לכל פריט)</label>
        <textarea name="features" rows="6" placeholder="VIP זהב&#10;Bugatti Chiron&#10;הזרקת כסף 30K"><%= product ? product.features || '' : '' %></textarea>

        <label>תגיות (מופרד בפסיק)</label>
        <input type="text" name="tags" value="<%= product ? product.tags || '' : '' %>" placeholder="ספורט, יוקרה, חדש">
      </div>

      <div class="form-col">
        <label>מחיר (₪) *</label>
        <input type="number" step="0.01" name="price" required value="<%= product ? product.price : '' %>">

        <label>מחיר מבצע (אופציונלי — מחיר סופי לפני תשלום)</label>
        <input type="number" step="0.01" name="sale_price" value="<%= product && product.sale_price ? product.sale_price : '' %>">

        <label>תווית (Badge)</label>
        <input type="text" name="badge" value="<%= product ? product.badge || '' : '' %>" placeholder="NEW / SALE / VIP">

        <label>צבע תווית</label>
        <input type="color" name="badge_color" value="<%= product && product.badge_color ? product.badge_color : '#a855f7' %>">

        <label>תמונה</label>
        <input type="file" name="image" accept="image/*">
        <% if (product && product.image_url) { %>
          <img src="<%= product.image_url %>" style="margin-top:8px;max-width:200px;border-radius:10px">
        <% } %>
        <label>או הדבק כתובת תמונה</label>
        <input type="text" name="image_url" value="<%= product && product.image_url && product.image_url.indexOf('/uploads/') !== 0 ? product.image_url : '' %>" placeholder="https://...">

        <label>סדר תצוגה</label>
        <input type="number" name="sort_order" value="<%= product ? product.sort_order : 0 %>">

        <label class="checkbox">
          <input type="checkbox" name="is_package" value="1" <%= product && product.is_package ? 'checked' : '' %>>
          זוהי חבילה (כוללת מספר פריטים)
        </label>
        <label class="checkbox">
          <input type="checkbox" name="active" value="1" <%= !product || product.active ? 'checked' : '' %>>
          מוצר פעיל
        </label>
      </div>

      <div class="form-actions">
        <button class="btn btn-primary btn-lg" type="submit"><%= product ? 'שמור שינויים' : 'צור מוצר' %></button>
        <a href="/admin/products" class="btn btn-ghost">ביטול</a>
      </div>
    </form>
  </main>
</div>
<%- include('../partials/footer') %>
