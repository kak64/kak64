<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar') %>
  <section class="dashboard-main">
    <h1>ניהול משתמשים</h1>
    <div class="card">
      <table>
        <thead><tr><th>#</th><th>שם</th><th>מייל</th><th>תפקיד</th><th>נרשם</th><th>פעולות</th></tr></thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.id %></td>
              <td><%= u.full_name %></td>
              <td dir="ltr"><%= u.email %></td>
              <td>
                <form method="post" action="/admin/users/<%= u.id %>/role" class="inline-form">
                  <select name="role" onchange="this.form.submit()">
                    <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>משתמש</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>מנהל</option>
                  </select>
                </form>
              </td>
              <td><%= u.created_at.split(' ')[0] %></td>
              <td>
                <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline-form" onsubmit="return confirm('למחוק משתמש?')">
                  <button class="btn btn-sm btn-danger">מחיקה</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>
