<%- include('../partials/header') %>
<div class="dash-layout">
  <%- include('_sidebar') %>
  <main class="dash-main">
    <h1 class="page-title">הגדרות</h1>
    <form method="post" action="/admin/settings" enctype="multipart/form-data" class="card">
      <h3>אתר</h3>
      <label>שם האתר</label>
      <input type="text" name="site_name" value="<%= settingsMap.site_name %>">

      <label>כותרת משנה</label>
      <input type="text" name="site_subtitle" value="<%= settingsMap.site_subtitle %>">

      <label>טקסט גיבור (Hero)</label>
      <input type="text" name="hero_tagline" value="<%= settingsMap.hero_tagline %>">

      <label>באנר ראשי (תמונה)</label>
      <input type="file" name="hero_image" accept="image/*">
      <% if (settingsMap.hero_image_url) { %>
        <img src="<%= settingsMap.hero_image_url %>" style="margin-top:8px;max-width:280px;border-radius:10px">
      <% } %>

      <hr>
      <h3>הודעה בעמוד הבית (בלוק טקסט אישי שאתה כותב)</h3>
      <p class="muted small">מופיע מתחת לעיגולי הקטגוריות. השאירו ריק כדי להסתיר.</p>
      <label>כותרת</label>
      <input type="text" name="home_message_title" value="<%= settingsMap.home_message_title %>">
      <label>גוף ההודעה (אפשר HTML פשוט — &lt;br&gt;, &lt;strong&gt;, &lt;a&gt;)</label>
      <textarea name="home_message_body" rows="4"><%= settingsMap.home_message_body %></textarea>

      <hr>
      <h3>יעד חודשי (סרגל התקדמות בעמוד הבית)</h3>
      <label>תווית היעד</label>
      <input type="text" name="monthly_goal_label" value="<%= settingsMap.monthly_goal_label %>">
      <label>סכום היעד (₪) — השאירו 0 כדי להסתיר</label>
      <input type="number" name="monthly_goal" value="<%= settingsMap.monthly_goal %>">

      <hr>
      <h3>פס הכרזה (מופיע למעלה בכל עמוד)</h3>
      <label>טקסט ההכרזה (השאירו ריק כדי להסתיר)</label>
      <input type="text" name="announcement_bar" value="<%= settingsMap.announcement_bar %>">
      <label>קישור להכרזה (אופציונלי)</label>
      <input type="text" name="announcement_link" value="<%= settingsMap.announcement_link %>">

      <hr>
      <h3>Discord</h3>
      <label>קישור הזמנה ל-Discord</label>
      <input type="text" name="discord_invite" value="<%= settingsMap.discord_invite %>">
      <label>Discord Webhook URL — שלח עדכון לכל הזמנה ששולמה</label>
      <input type="text" name="discord_webhook_url" value="<%= settingsMap.discord_webhook_url %>" placeholder="https://discord.com/api/webhooks/...">
      <p class="muted small">צרו webhook בערוץ ב-Discord (Edit Channel → Integrations → Webhooks → New Webhook → העתק URL)</p>

      <hr>
      <h3>FiveM Server (live status widget)</h3>
      <label>כתובת השרת — IP:PORT (למשל 1.2.3.4:30120)</label>
      <input type="text" name="fivem_endpoint" value="<%= settingsMap.fivem_endpoint %>">
      <label>שם השרת לתצוגה</label>
      <input type="text" name="fivem_server_name" value="<%= settingsMap.fivem_server_name %>">

      <hr>
      <h3>🎟 קודי מימוש — חיבור לשרת FiveM</h3>
      <p class="muted small">השרת ב-FiveM יקרא ל-<code>POST /api/redeem</code> כדי לאמת קודים. העתיקו את הטוקן לסקריפט שבתיקייה <code>fivem/infinity-redeem/</code>.</p>
      <label>API Token (לסקריפט בשרת FiveM)</label>
      <input type="text" name="fivem_api_token" value="<%= settingsMap.fivem_api_token %>" readonly style="font-family:monospace">
      <label>תחילית קוד מימוש (לדוגמה <code>inf</code> ייצור קודים כמו <code>inf-A1B2C3D4E5</code>)</label>
      <input type="text" name="receipt_prefix" value="<%= settingsMap.receipt_prefix %>" maxlength="10">

      <hr>
      <h3>תשלום ומחירים</h3>
      <label>תוספת מחיר (₪) — מתווסף בעת תשלום</label>
      <input type="number" step="0.01" name="extra_fee" value="<%= settingsMap.extra_fee %>">
      <label>קודי הנחה — פורמט: <code>WELCOME10:10,SUMMER20:20</code></label>
      <input type="text" name="discount_codes" value="<%= settingsMap.discount_codes %>">

      <hr>
      <h3>תוכנית נאמנות</h3>
      <label>נקודות לכל ₪ שמוציאים</label>
      <input type="number" step="0.1" name="points_per_currency" value="<%= settingsMap.points_per_currency %>">
      <label>שער פדיון — כמה נקודות שווות ₪1</label>
      <input type="number" name="points_redeem_rate" value="<%= settingsMap.points_redeem_rate %>">
      <label>בונוס הפניה (₪ — לשני הצדדים, אחרי הזמנה ראשונה)</label>
      <input type="number" name="referral_bonus" value="<%= settingsMap.referral_bonus %>">

      <button class="btn btn-primary mt" type="submit">שמור</button>
    </form>

    <form method="post" action="/admin/settings/rotate-token" class="card" onsubmit="return confirm('להחליף את ה-API token? הסקריפט בשרת FiveM יפסיק לעבוד עד שתעדכנו אותו.')">
      <h3>החלפת API token</h3>
      <p class="muted small">לחיצה תייצר טוקן חדש. אחרי זה צריך לעדכן את הקובץ <code>config.lua</code> ב-FiveM.</p>
      <button class="btn btn-danger" type="submit">🔄 צור טוקן חדש</button>
    </form>
  </main>
</div>
<%- include('../partials/footer') %>
