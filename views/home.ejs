<%- include('partials/header') %>

<%- include('partials/circle-nav') %>

<% if ((homeMessageTitle && homeMessageTitle.trim()) || (homeMessageBody && homeMessageBody.trim())) { %>
  <section class="home-message">
    <% if (homeMessageTitle && homeMessageTitle.trim()) { %>
      <h2 class="home-message-title"><%= homeMessageTitle %></h2>
    <% } %>
    <% if (homeMessageBody && homeMessageBody.trim()) { %>
      <div class="home-message-body"><%- homeMessageBody %></div>
    <% } %>
  </section>
<% } %>

<!-- Banner hero -->
<section class="store-hero <%= heroImageUrl ? 'has-image' : '' %>">
  <% if (heroImageUrl) { %>
    <img src="<%= heroImageUrl %>" alt="" class="hero-bg-img">
  <% } %>
  <div class="hero-overlay"></div>
  <div class="hero-inner">
    <div class="hero-logo-row">
      <img src="/img/logo.svg" alt="Infinity IL" class="hero-logo-mini">
      <div>
        <h1 class="hero-name">INFINITY <span class="hero-il">IL</span></h1>
        <div class="hero-sub"><%= siteSubtitle || 'ROLEPLAY SERVER STORE' %></div>
      </div>
    </div>
    <p class="hero-tag"><%= heroTagline || 'הצטרפו לקהילה הכי טובה — חנות, חבילות והטבות בלעדיות.' %></p>
    <div class="hero-actions">
      <% if (discordInvite) { %>
        <a href="<%= discordInvite %>" target="_blank" rel="noopener" class="btn btn-discord btn-lg">הצטרפו ל-Discord</a>
      <% } %>
      <a href="#products" class="btn btn-primary btn-lg">המוצרים שלנו</a>
    </div>
  </div>
</section>

<div class="store-layout">
  <%- include('partials/store-sidebar', { categoriesAll: categoriesAll }) %>

  <main class="store-main">

    <% if (flashDeals && flashDeals.length) { %>
      <section class="flash-strip">
        <div class="flash-head">
          <h2>⚡ מבצעי בזק — מהר לפני שייגמר</h2>
        </div>
        <div class="flash-grid">
          <% flashDeals.forEach(function(fd){ %>
            <a href="/product/<%= fd.product_id %>" class="flash-card" data-ends="<%= fd.ends_at %>">
              <div class="flash-image">
                <% if (fd.image_url) { %><img src="<%= fd.image_url %>" alt=""><% } else { %><div class="image-placeholder"><span class="ph-icon"><%= fd.category_icon || '⚡' %></span></div><% } %>
              </div>
              <div class="flash-body">
                <div class="flash-name"><%= fd.product_name %></div>
                <div class="flash-prices">
                  <span class="price-old"><%= formatCurrency(fd.product_price) %></span>
                  <span class="price-now flash"><%= formatCurrency(fd.deal_price) %></span>
                </div>
                <div class="flash-cd"><span class="cd-text">⏱ —</span></div>
              </div>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (featured && featured.length) { %>
      <section class="store-section">
        <div class="section-head">
          <h2><span class="sh-icon">⭐</span>מומלצים השבוע</h2>
        </div>
        <div class="product-grid">
          <% featured.forEach(function(product){ %>
            <%- include('partials/product-card', { product: product }) %>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (bestSellers && bestSellers.length && bestSellers.some(function(p){ return (p.sold_count||0) > 0; })) { %>
      <section class="store-section">
        <div class="section-head">
          <h2><span class="sh-icon">🔥</span>הכי נמכרים</h2>
        </div>
        <div class="product-grid">
          <% bestSellers.forEach(function(product){ %>
            <%- include('partials/product-card', { product: product }) %>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% var grouped = {};
       (categoriesAll || []).forEach(function(c){ grouped[c.id] = { cat: c, items: [] }; });
       products.forEach(function(p){ if (grouped[p.category_id]) grouped[p.category_id].items.push(p); });
    %>

    <section id="products" class="products-section">
      <% Object.values(grouped).forEach(function(g){ if (!g.items.length) return; %>
        <div id="cat-<%= g.cat.slug %>" class="cat-block" style="--cat-color: <%= g.cat.color || '#a855f7' %>">
          <div class="section-head">
            <h2><span class="sh-icon"><%= g.cat.icon || '✦' %></span><%= g.cat.name %></h2>
            <a class="cat-more" href="/category/<%= g.cat.slug %>">לכל ה<%= g.cat.name %> ←</a>
          </div>
          <div class="product-grid">
            <% g.items.slice(0, 8).forEach(function(product){ %>
              <%- include('partials/product-card', { product: product }) %>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </section>

    <section class="trust-section">
      <div class="trust-grid">
        <div class="trust-card"><div class="trust-icon">⚡</div><h3>הפעלה מיידית</h3><p>ההטבה מופעלת אוטומטית תוך פחות מדקה.</p></div>
        <div class="trust-card"><div class="trust-icon">🔒</div><h3>תשלום מאובטח</h3><p>PayPal ו-Bit — מוצפנים, מאובטחים ומיידיים.</p></div>
        <div class="trust-card"><div class="trust-icon">💬</div><h3>תמיכה 24/7</h3><p>הצוות זמין ב-Discord תמיד שתצטרכו.</p></div>
        <div class="trust-card"><div class="trust-icon">🎁</div><h3>נקודות ובונוסים</h3><p>על כל קנייה — נקודות. הביאו חבר — שניכם מרוויחים.</p></div>
      </div>
    </section>

    <% if (faqs && faqs.length) { %>
      <section class="faq-section">
        <h2 class="section-title">שאלות נפוצות</h2>
        <div class="faq-list">
          <% faqs.forEach(function(f){ %>
            <details class="faq-item">
              <summary><%= f.question %></summary>
              <div><%= f.answer %></div>
            </details>
          <% }); %>
        </div>
      </section>
    <% } %>

  </main>
</div>

<%- include('partials/footer') %>
