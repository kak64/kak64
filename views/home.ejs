<%- include('partials/header') %>

<section class="hero">
  <div class="hero-card">
    <div class="hero-logo">
      <img src="/img/logo.svg" alt="Infinity IL">
    </div>
    <h1 class="hero-title">
      <span class="hero-name">INFINITY <span class="hero-il">IL</span></span>
      <span class="hero-sub"><%= siteSubtitle || 'ROLEPLAY SERVER STORE' %></span>
    </h1>
    <p class="hero-tag"><%= heroTagline || 'הצטרפו לקהילה הכי טובה — חנות, חבילות והטבות בלעדיות.' %></p>

    <div id="server-status" class="server-status loading" data-name="<%= fivemServerName || 'Infinity IL Roleplay' %>">
      <div class="ss-dot"></div>
      <div class="ss-text">
        <div class="ss-label muted">FiveM Server</div>
        <div class="ss-name"><%= fivemServerName || 'Infinity IL Roleplay' %></div>
      </div>
      <div class="ss-players">
        <span class="ss-num">—</span><span class="ss-max"></span>
        <span class="ss-lbl muted">שחקנים</span>
      </div>
    </div>

    <div class="hero-stats">
      <div class="hero-stat"><span class="num">24/7</span><span class="lbl">פעילות</span></div>
      <div class="hero-stat"><span class="num"><%= products.length %></span><span class="lbl">מוצרים</span></div>
      <div class="hero-stat"><span class="num">∞</span><span class="lbl">פוטנציאל</span></div>
    </div>
    <div class="hero-actions">
      <% if (discordInvite) { %>
        <a href="<%= discordInvite %>" target="_blank" rel="noopener" class="btn btn-discord">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.196.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          הצטרפו ל-Discord
        </a>
      <% } %>
      <a href="#products" class="btn btn-ghost">המוצרים שלנו</a>
    </div>
  </div>
</section>

<% if (activity && activity.length) { %>
  <section class="activity-section">
    <div class="activity-head">
      <span class="live-dot"></span>
      <span>רכישות אחרונות בשרת</span>
    </div>
    <div class="ticker">
      <div class="ticker-track">
        <% activity.concat(activity).forEach(function(a){ %>
          <div class="ticker-item">
            <% if (a.avatar_url) { %><img src="<%= a.avatar_url %>" alt="" class="ticker-avatar"><% } else { %><span class="ticker-avatar fallback"><%= (a.username || '?').slice(0,1).toUpperCase() %></span><% } %>
            <span><strong><%= a.username || 'אורח' %></strong> רכש/ה <a href="/product/<%= a.product_id %>"><%= a.product_name %></a></span>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<% if (flashDeals && flashDeals.length) { %>
  <section class="flash-strip">
    <div class="flash-head">
      <h2>⚡ מבצעי בזק — מהר לפני שייגמר</h2>
    </div>
    <div class="flash-grid">
      <% flashDeals.forEach(function(fd){ %>
        <a href="/product/<%= fd.product_id %>" class="flash-card" data-ends="<%= fd.ends_at %>">
          <div class="flash-image">
            <% if (fd.image_url) { %><img src="<%= fd.image_url %>" alt=""><% } else { %><div class="image-placeholder"><span class="ph-icon"><%= fd.category_icon || '⚡' %></span></div><% } %>
          </div>
          <div class="flash-body">
            <div class="flash-name"><%= fd.product_name %></div>
            <div class="flash-prices">
              <span class="price-old"><%= formatCurrency(fd.product_price) %></span>
              <span class="price-now flash"><%= formatCurrency(fd.deal_price) %></span>
            </div>
            <div class="flash-cd"><span class="cd-text">⏱ —</span></div>
          </div>
        </a>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (featured && featured.length) { %>
  <section class="featured-section">
    <div class="cat-header">
      <h2 class="cat-title"><span class="cat-icon">⭐</span>מומלצים השבוע</h2>
    </div>
    <div class="product-grid">
      <% featured.forEach(function(product){ %>
        <%- include('partials/product-card', { product: product }) %>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (bestSellers && bestSellers.length && bestSellers.some(function(p){ return (p.sold_count||0) > 0; })) { %>
  <section class="featured-section">
    <div class="cat-header">
      <h2 class="cat-title"><span class="cat-icon">🔥</span>הכי נמכרים</h2>
    </div>
    <div class="product-grid">
      <% bestSellers.forEach(function(product){ %>
        <%- include('partials/product-card', { product: product }) %>
      <% }); %>
    </div>
  </section>
<% } %>

<% var grouped = {};
   (categoriesAll || []).forEach(function(c){ grouped[c.id] = { cat: c, items: [] }; });
   products.forEach(function(p){ if (grouped[p.category_id]) grouped[p.category_id].items.push(p); });
%>

<section id="products" class="products-section">
  <% Object.values(grouped).forEach(function(g){ if (!g.items.length) return; %>
    <div class="cat-block" style="--cat-color: <%= g.cat.color || '#a855f7' %>">
      <div class="cat-header">
        <h2 class="cat-title"><span class="cat-icon"><%= g.cat.icon || '✦' %></span><%= g.cat.name %></h2>
        <a class="cat-more" href="/category/<%= g.cat.slug %>">לכל ה<%= g.cat.name %> ←</a>
      </div>
      <div class="product-grid">
        <% g.items.forEach(function(product){ %>
          <%- include('partials/product-card', { product: product }) %>
        <% }); %>
      </div>
    </div>
  <% }); %>
</section>

<section class="trust-section">
  <div class="trust-grid">
    <div class="trust-card"><div class="trust-icon">⚡</div><h3>הפעלה מיידית</h3><p>ההטבה מופעלת אוטומטית תוך פחות מדקה.</p></div>
    <div class="trust-card"><div class="trust-icon">🔒</div><h3>תשלום מאובטח</h3><p>PayPal ו-Bit — תשלומים מוצפנים, מאובטחים ומיידיים.</p></div>
    <div class="trust-card"><div class="trust-icon">💬</div><h3>תמיכה 24/7</h3><p>הצוות שלנו זמין ב-Discord תמיד שתצטרכו עזרה.</p></div>
    <div class="trust-card"><div class="trust-icon">🎁</div><h3>נקודות ובונוסים</h3><p>על כל קנייה מקבלים נקודות. הביאו חבר — שניכם מרוויחים.</p></div>
  </div>
</section>

<% if (testimonials && testimonials.length) { %>
  <section class="testimonials-section">
    <h2 class="section-title">מה אומרים עלינו</h2>
    <div class="testimonials-grid">
      <% testimonials.forEach(function(t){ %>
        <div class="testimonial-card">
          <div class="t-stars">
            <% for (var i = 1; i <= 5; i++) { %><span class="<%= i <= t.rating ? 'on' : '' %>">★</span><% } %>
          </div>
          <p class="t-body">"<%= t.body %>"</p>
          <div class="t-author">
            <% if (t.avatar_url) { %><img src="<%= t.avatar_url %>" alt=""><% } else { %><span class="user-initial"><%= t.author.slice(0,1).toUpperCase() %></span><% } %>
            <strong><%= t.author %></strong>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (faqs && faqs.length) { %>
  <section class="faq-section">
    <h2 class="section-title">שאלות נפוצות</h2>
    <div class="faq-list">
      <% faqs.forEach(function(f){ %>
        <details class="faq-item">
          <summary><%= f.question %></summary>
          <div><%= f.answer %></div>
        </details>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (discordInvite) { %>
  <section class="cta-section">
    <h2>רוצים את החוויה המלאה?</h2>
    <p>הצטרפו ל-Discord שלנו — עדכונים, מבצעים בלעדיים, וקהילה פעילה 24/7.</p>
    <a href="<%= discordInvite %>" target="_blank" rel="noopener" class="btn btn-discord btn-lg">הצטרפו ל-Discord</a>
  </section>
<% } %>

<%- include('partials/footer') %>
