<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>
  <section class="dashboard-main">
    <h1>שלום, <%= user.full_name %></h1>

    <div class="stats-grid">
      <div class="stat"><div class="num"><%= servers.length %></div><div>שרתים פעילים</div></div>
      <div class="stat"><div class="num"><%= invoices.filter(i => i.status === 'pending').length %></div><div>חשבוניות ממתינות</div></div>
      <div class="stat"><div class="num"><%= tickets.filter(t => t.status !== 'closed').length %></div><div>פניות פתוחות</div></div>
      <div class="stat"><div class="num"><%= user.balance.toFixed(2) %> ₪</div><div>יתרת חשבון</div></div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3>השרתים שלי</h3>
        <a href="/dashboard/servers/order" class="btn btn-primary btn-sm">הזמנת שרת חדש</a>
      </div>
      <% if (servers.length === 0) { %>
        <p class="muted">אין לך עדיין שרתים. <a href="/dashboard/servers/order">להזמנת שרת ראשון</a></p>
      <% } else { %>
        <table>
          <thead><tr><th>שם שרת</th><th>חבילה</th><th>סטטוס</th><th>IP</th><th></th></tr></thead>
          <tbody>
            <% servers.forEach(function(s) { %>
              <tr>
                <td><%= s.hostname %></td>
                <td><%= s.plan_name %></td>
                <td><span class="status status-<%= s.status %>"><%= s.status %></span></td>
                <td><%= s.ip_address || '—' %></td>
                <td><a href="/dashboard/servers/<%= s.id %>">פרטים</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <div class="card-header"><h3>חשבוניות אחרונות</h3><a href="/dashboard/billing">לכל החשבוניות</a></div>
      <% if (invoices.length === 0) { %>
        <p class="muted">אין חשבוניות.</p>
      <% } else { %>
        <table>
          <thead><tr><th>#</th><th>תיאור</th><th>סכום</th><th>סטטוס</th><th>תאריך</th></tr></thead>
          <tbody>
            <% invoices.forEach(function(i) { %>
              <tr>
                <td>#<%= i.id %></td>
                <td><a href="/dashboard/billing/<%= i.id %>"><%= i.description %></a></td>
                <td><%= i.amount.toFixed(2) %> ₪</td>
                <td><span class="status status-<%= i.status %>"><%= i.status === 'paid' ? 'שולם' : 'ממתין' %></span></td>
                <td><%= i.created_at.split(' ')[0] %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>
</div>
