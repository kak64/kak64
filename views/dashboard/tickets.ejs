<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>
  <section class="dashboard-main">
    <div class="page-header-row">
      <h1>פניות תמיכה</h1>
      <a href="/dashboard/tickets/new" class="btn btn-primary">פנייה חדשה</a>
    </div>
    <% if (tickets.length === 0) { %>
      <div class="card empty"><p>אין פניות פתוחות.</p></div>
    <% } else { %>
      <div class="card">
        <table>
          <thead><tr><th>#</th><th>נושא</th><th>עדיפות</th><th>סטטוס</th><th>תאריך</th></tr></thead>
          <tbody>
            <% tickets.forEach(function(t) { %>
              <tr>
                <td>#<%= t.id %></td>
                <td><a href="/dashboard/tickets/<%= t.id %>"><%= t.subject %></a></td>
                <td><%= t.priority %></td>
                <td><span class="status status-<%= t.status %>"><%= t.status %></span></td>
                <td><%= t.created_at.split(' ')[0] %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
