<%- include('../partials/header') %>

<h1 class="page-title">הפרופיל שלי</h1>

<div class="card">
  <form method="post" action="/dashboard/profile">
    <label>שם משתמש</label>
    <input type="text" name="username" value="<%= user.username %>" required>
    <label>אימייל</label>
    <input type="email" name="email" value="<%= user.email || '' %>">
    <hr>
    <h3>שינוי סיסמה (אופציונלי)</h3>
    <label>סיסמה חדשה</label>
    <input type="password" name="password" minlength="6">
    <label>אימות סיסמה</label>
    <input type="password" name="password2" minlength="6">
    <button class="btn btn-primary mt" type="submit">שמור שינויים</button>
  </form>
</div>

<% if (user.discord_id || user.cfx_id) { %>
  <div class="card">
    <h3>חשבונות מקושרים</h3>
    <% if (user.discord_id) { %>
      <div class="row"><span>Discord</span><strong><%= user.discord_username || user.discord_id %></strong></div>
    <% } %>
    <% if (user.cfx_id) { %>
      <div class="row"><span>Cfx.re</span><strong><%= user.cfx_username || user.cfx_id %></strong></div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
