<%- include('partials/header') %>

<section class="page-head" style="--cat-color: <%= category.color || '#a855f7' %>">
  <div class="page-head-icon"><%= category.icon || '✦' %></div>
  <div>
    <h1 class="page-title"><%= category.name %></h1>
    <p class="page-sub"><%= products.length %> מוצרים בקטגוריה</p>
  </div>
</section>

<% if (!products.length) { %>
  <p class="empty">אין מוצרים בקטגוריה כרגע.</p>
<% } else { %>
  <div class="product-grid product-grid-large">
    <% products.forEach(function(product){ %>
      <%- include('partials/product-card', { product: product }) %>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
