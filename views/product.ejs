<%- include('partials/header') %>

<%
  var unit = effectivePrice(product, flashDeal);
  var rating = avgRating(product);
  var ratingCount = product.rating_count || 0;
  var sold = product.sold_count || 0;
  var stockLow = (product.stock !== null && product.stock !== undefined && product.stock > 0 && product.stock <= 5);
  var soldOut = (product.stock === 0);
  var fav = (typeof user !== 'undefined' && user) ? isWishlisted(product.id) : false;
%>

<div class="product-detail" style="--cat-color: <%= product.category_color || '#a855f7' %>">
  <div class="product-detail-image">
    <% if (flashDeal) { %>
      <span class="badge flash-badge">⚡ FLASH</span>
    <% } else if (product.badge) { %>
      <span class="badge" style="background: <%= product.badge_color || '#a855f7' %>"><%= product.badge %></span>
    <% } %>
    <% if (product.image_url) { %>
      <img src="<%= product.image_url %>" alt="<%= product.name %>">
    <% } else { %>
      <div class="image-placeholder image-placeholder-large">
        <span class="ph-icon"><%= product.category_icon || '✦' %></span>
        <span class="ph-text"><%= product.category_name || 'INFINITY IL' %></span>
      </div>
    <% } %>
  </div>

  <div class="product-detail-body">
    <a class="muted" href="/category/<%= product.category_slug %>">← <%= product.category_name %></a>
    <h1><%= product.name %></h1>

    <% if (ratingCount > 0 || sold > 0) { %>
      <div class="rating-row">
        <% if (ratingCount > 0) { %>
          <span class="stars">
            <% for (var i = 1; i <= 5; i++) { %><span class="<%= i <= Math.round(rating) ? 'on' : '' %>">★</span><% } %>
          </span>
          <span class="muted"><%= rating.toFixed(1) %> · <%= ratingCount %> ביקורות</span>
        <% } %>
        <% if (sold > 0) { %>
          <span class="muted">· <%= sold %> נמכרו</span>
        <% } %>
      </div>
    <% } %>

    <% if (product.tags) { %>
      <div class="tags">
        <% product.tags.split(',').map(function(t){ return t.trim(); }).filter(Boolean).forEach(function(t){ %>
          <span class="tag"><%= t %></span>
        <% }); %>
      </div>
    <% } %>
    <p class="lead"><%= product.description %></p>

    <% if (flashDeal) { %>
      <div class="flash-banner" data-ends="<%= flashDeal.ends_at %>">
        <span>⚡ מבצע בזק — מסתיים בעוד</span>
        <span class="cd-text big">—</span>
      </div>
    <% } %>

    <% if (soldOut) { %>
      <div class="stock-warn out">⛔ אזל מהמלאי</div>
    <% } else if (stockLow) { %>
      <div class="stock-warn low">🔥 נשארו <%= product.stock %> בלבד — מהרו!</div>
    <% } %>

    <% if (product.features) { %>
      <div class="features-box">
        <div class="features-title">
          <% if (product.is_package) { %>📦 מה כלול בחבילה<% } else { %>✦ מה כלול<% } %>
        </div>
        <ul>
          <% product.features.split('\n').map(function(f){ return f.trim(); }).filter(Boolean).forEach(function(f){ %>
            <li><span class="check">✓</span><%= f %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="buy-row">
      <div class="price-large">
        <% if (flashDeal) { %>
          <span class="price-old"><%= formatCurrency(product.price) %></span>
          <span class="price-now flash"><%= formatCurrency(unit) %></span>
        <% } else if (product.sale_price && product.sale_price > 0) { %>
          <span class="price-old"><%= formatCurrency(product.price) %></span>
          <span class="price-now"><%= formatCurrency(product.sale_price) %></span>
        <% } else { %>
          <span class="price-now"><%= formatCurrency(product.price) %></span>
        <% } %>
      </div>
      <% if (!soldOut) { %>
        <form method="post" action="/cart/add" class="buy-form">
          <input type="hidden" name="product_id" value="<%= product.id %>">
          <input type="number" name="qty" value="1" min="1" class="qty-input">
          <button class="btn btn-primary btn-lg" type="submit">הוסף לעגלה</button>
        </form>
      <% } else { %>
        <button class="btn btn-ghost btn-lg" disabled>אזל מהמלאי</button>
      <% } %>
    </div>

    <% if (typeof user !== 'undefined' && user) { %>
      <form method="post" action="/wishlist/toggle" class="mt">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <button class="btn btn-ghost <%= fav ? 'is-fav' : '' %>" type="submit">
          <%= fav ? '♥ במועדפים — הסר' : '♡ הוסף למועדפים' %>
        </button>
      </form>
    <% } %>
  </div>
</div>

<section id="reviews" class="reviews-section">
  <h2>ביקורות (<%= reviews.length %>)</h2>

  <% if (canReview) { %>
    <div class="card review-form">
      <h3>כתבו ביקורת</h3>
      <form method="post" action="/reviews/<%= product.id %>">
        <div class="rating-input" id="ratingInput">
          <% for (var i = 5; i >= 1; i--) { %>
            <input type="radio" name="rating" id="r<%= i %>" value="<%= i %>" <%= i === 5 ? 'checked' : '' %>>
            <label for="r<%= i %>" title="<%= i %> כוכבים">★</label>
          <% } %>
        </div>
        <textarea name="comment" placeholder="ספרו לאחרים מה דעתכם על המוצר..." rows="3" maxlength="1000"></textarea>
        <button class="btn btn-primary mt" type="submit">פרסם ביקורת</button>
      </form>
    </div>
  <% } else if (typeof user !== 'undefined' && user) { %>
    <p class="muted">ניתן להגיב רק אחרי שרכשתם את המוצר.</p>
  <% } else { %>
    <p class="muted"><a href="/auth/login">התחברו</a> כדי לכתוב ביקורת.</p>
  <% } %>

  <% if (!reviews.length) { %>
    <p class="muted">עוד אין ביקורות — היו הראשונים!</p>
  <% } else { %>
    <div class="review-list">
      <% reviews.forEach(function(r){ %>
        <div class="review">
          <div class="review-head">
            <strong><%= r.username || 'משתמש' %></strong>
            <span class="stars">
              <% for (var i = 1; i <= 5; i++) { %><span class="<%= i <= r.rating ? 'on' : '' %>">★</span><% } %>
            </span>
            <span class="muted small"><%= new Date(r.created_at).toLocaleDateString('he-IL') %></span>
          </div>
          <% if (r.comment) { %><p><%= r.comment %></p><% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>

<% if (related && related.length) { %>
  <section class="related">
    <h2>מוצרים נוספים</h2>
    <div class="product-grid">
      <% related.forEach(function(product){ %>
        <%- include('partials/product-card', { product: product }) %>
      <% }); %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
