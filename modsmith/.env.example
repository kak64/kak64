# ───────────── Core ─────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Modsmith
# 32+ random bytes, base64. Used for session token hashing/HMAC and token encryption.
APP_SECRET=change-me-generate-with-openssl-rand-base64-48
# Separate key for encrypting Discord OAuth tokens at rest (base64, 32 bytes)
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ───────────── Database ─────────────
DATABASE_URL=postgresql://modsmith:modsmith@localhost:5432/modsmith?schema=public
# Used by vitest integration tests
TEST_DATABASE_URL=postgresql://modsmith:modsmith@localhost:5432/modsmith_test?schema=public

# ───────────── Redis (queues, cache, rate limits) ─────────────
REDIS_URL=redis://localhost:6379

# ───────────── Object storage (S3-compatible: Cloudflare R2, MinIO, AWS S3) ─────────────
STORAGE_PROVIDER=s3            # s3 | local (local = ./apps/web/.storage, dev only)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=modsmith
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Optional public CDN base for non-sensitive assets (thumbnails). Private objects always use signed URLs.
S3_PUBLIC_BASE_URL=

# ───────────── Stripe ─────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ───────────── Discord ─────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

# ───────────── Email (resend | postmark | ses | smtp | console) ─────────────
EMAIL_PROVIDER=console
EMAIL_FROM="Modsmith <no-reply@modsmith.app>"
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_URL=

# ───────────── AI image-to-3D provider (mock | tripo | meshy | custom) ─────────────
AI_3D_PROVIDER=mock
AI_3D_API_KEY=
AI_3D_ENDPOINT=

# ───────────── External sources ─────────────
SKETCHFAB_API_TOKEN=
# Comma-separated allowlist of hosts the car importer may fetch from
IMPORT_URL_ALLOWLIST=www.gta5-mods.com,gta5-mods.com,cdn.gta5-mods.com

# ───────────── Malware scanning (clamav | none) ─────────────
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ───────────── Worker ─────────────
WORKER_CONCURRENCY=2
WORKER_TMP_DIR=./apps/worker/tmp
BLENDER_BIN=
CODEWALKER_CLI=

# ───────────── Observability ─────────────
LOG_LEVEL=info
SENTRY_DSN=
METRICS_TOKEN=change-me

# Local storage provider (STORAGE_PROVIDER=local) — development and tests only
LOCAL_STORAGE_DIR=./.storage

# ───────────── Seed / admin bootstrap ─────────────
ADMIN_EMAIL=admin@modsmith.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
