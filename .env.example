# ===== Server =====
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — if unset, the server falls back to an in-memory store (great for local dev/demo)
MONGODB_URI=

# Encryption key for the password vault (AES-256). Must be 32 bytes (64 hex chars) in production.
VAULT_KEY=

# ===== AI assistant =====
# Provider: "rules" (offline, default) | "anthropic" | "openai" | "gemini"
AI_PROVIDER=rules
# Model id (used when provider is an LLM). e.g. claude-sonnet-4-6, gpt-4o-mini, gemini-1.5-flash
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Client =====
# Base URL the React client uses to reach the API
VITE_API_URL=http://localhost:4000
