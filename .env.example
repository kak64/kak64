PORT=3000

# REQUIRED: long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# REQUIRED: 32-byte hex key for encrypting sensitive fields at rest
# (server root passwords, API tokens). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: do not change once set, or existing encrypted data will be unreadable.
ENCRYPTION_KEY=

# Set to "production" to enable secure cookies (requires HTTPS)
NODE_ENV=development

# When behind nginx/Caddy/Cloudflare, set to 1 so secure cookies work
TRUST_PROXY=0

# ESXi connection details
ESXI_HOST=195.154.171.166
ESXI_USER=root
ESXI_PASS=your-esxi-password
ESXI_DATASTORE=datastore1
ESXI_NETWORK=VM Network

# Admin bootstrap (synced to DB on every startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Brand
BRAND_NAME=FutureIL Hosting
SUPPORT_EMAIL=support@futureil.example.com
SUPPORT_PHONE=03-0000000
