PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string-please

# Bootstrap admin (created on first run if DB empty)
ADMIN_EMAIL=admin@infinity-il.com
ADMIN_PASSWORD=change-me-now
ADMIN_USERNAME=admin

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# CFX / FiveM OAuth (https://forum.cfx.re/ — uses standard OAuth2)
CFX_CLIENT_ID=
CFX_CLIENT_SECRET=
CFX_REDIRECT_URI=http://localhost:3000/auth/cfx/callback

# PayPal (REST). Leave empty to fall back to mock checkout
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Bit (Israeli payment app) — typically integrated via Pelecard/Tranzila
# Leave empty to use mock
BIT_MERCHANT_ID=
BIT_API_KEY=

# SMTP (for emailing receipt codes after purchase). Leave SMTP_HOST empty
# to fall back to console logging.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Infinity IL <no-reply@infinity-il.com>

# Receipt code prefix (also editable from /admin/settings).
# Codes look like inf-A1B2C3D4E5F6
RECEIPT_PREFIX=inf

# Currency
CURRENCY=ILS
CURRENCY_SYMBOL=₪
